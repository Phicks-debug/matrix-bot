# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

BROODS_DASHBOARD_URL="https://dashboard.broods.app"
BROODS_BASE_URL="https://gateway.broods.app"
BROODS_PROJECT="matrix-bot"
BROODS_STAGE="development"
BROODS_REGION="eu-west-1"

# Broods runtime key, from `broods login`.
BROODS_API_KEY=""

# Model key for the deepseek provider in broods/index.ts.
DEEPSEEK_API_KEY=""

# Access token for the Matrix device the forwarder syncs as. See README.
MATRIX_BOT_TOKEN=""
